# Copy to .env for local development. Never commit real values.
# Required in production; the dev script uses a fixed fallback when unset.
AUTH_SECRET=dev-only-change-me-32-chars-minimum

# Cloudflare credentials for `bun alchemy deploy` and CI. Token permissions:
# Workers Admin, D1/R2/Vectorize/Secrets Store edit, Account Settings read.
# See docs/operations.md#cloudflare-api-token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Public web origin (HTTPS + cross-site cookies). Production deploys derive it
# from the deployed site URL; set it to skip the second deploy pass.
APP_ORIGIN=http://localhost:5173

# Optional: encrypts OAuth tokens and stored connector credentials at rest.
# Defaults to AUTH_SECRET when unset.
# TOKEN_KEY=

# Email. Only needed when email OTP is enabled; password sign-in always works.
# Sending uses the Cloudflare Email Service `send_email` binding provisioned by
# alchemy.run.ts. Onboard the domain under Compute → Email Service first, then
# use an address on it here.
# EMAIL_FROM="OmniBrain <omnibrain@yourdomain.com>"

# Email OTP feature flag. Off in production unless set to 1. The dev server
# defaults it on and prints the code/returns dev_code; set 0 to test password only.
# AUTH_OTP_ENABLED=1

# OAuth apps for one-click sign-in. Register the app with the provider once and
# set the credentials here; the App Store then redirects straight to the provider.
# Redirect URI: http://localhost:8787/api/v1/oauth/<app>/callback
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Optional local dev port for the API (default 8787).
# PORT=8787
